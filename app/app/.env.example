# Copia de ejemplo sin secretos. Todas las variables tienen el mismo valor por defecto en compose.yaml.
GROUP_ID=ventas-aggregator-ep5
WINDOW_SECONDS=60
WINDOW_GRACE_SECONDS=30
DEDUP_RETENTION_HOURS=24
PRODUCE_INTERVAL=1.0
PRODUCER_MAX_EVENTS=0
CUSTOMER_POOL=200
PRODUCER_MODE=aleatorio
SCENARIO_STORE=Tienda Escenarios
PROMETHEUS_PORT=9090
GRAFANA_PORT=3300
# Solo para el admin del Grafana local (127.0.0.1). Cambialo en un .env propio si lo expones.
GRAFANA_ADMIN_PASSWORD=solo-local-cambiar
